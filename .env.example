# UNO Game Environment Variables
PORT=3000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/uno_game?retryWrites=true&w=majority

# Example for Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/uno_game
MONGODB_URI=mongodb://127.0.0.1:27017/uno_game
